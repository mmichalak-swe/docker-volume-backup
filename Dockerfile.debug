FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
WORKDIR /app/cmd/backup
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/backup .

FROM alpine:3.23 AS runtime-assets

RUN apk add --no-cache ca-certificates tzdata

RUN mkdir -p \
  /out/etc/ssl/certs \
  /out/usr/share \
  /out/tmp \
  /out/var/lock \
  /out/etc/dockervolumebackup/notifications.d \
  /out/home/nonroot \
  /out/usr/bin

RUN cp /etc/ssl/certs/ca-certificates.crt /out/etc/ssl/certs/ca-certificates.crt && \
  cp -a /usr/share/zoneinfo /out/usr/share/zoneinfo && \
  printf 'nonroot:x:65532:65532:nonroot:/home/nonroot:/sbin/nologin\n' > /out/etc/passwd && \
  printf 'nonroot:x:65532:\n' > /out/etc/group && \
  chmod 1777 /out/tmp && \
  chmod 1777 /out/var/lock && \
  chown -R 65532:65532 /out/home/nonroot

FROM alpine:3.23

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /home/nonroot

COPY --from=runtime-assets /out/etc/passwd /etc/passwd
COPY --from=runtime-assets /out/etc/group /etc/group
COPY --from=runtime-assets /out/etc/dockervolumebackup /etc/dockervolumebackup
COPY --from=builder /out/backup /usr/bin/backup

RUN mkdir -p /home/nonroot && \
  chown -R 65532:65532 /home/nonroot && \
  chmod 1777 /tmp && \
  chmod 1777 /var/lock

ENTRYPOINT ["/bin/sh", "-lc", "sleep infinity"]
